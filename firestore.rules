rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 상담 접수: 누구나 '새로 쓰기'만 가능. 읽기/수정/삭제는 불가 (관리 프로그램은 서비스 계정으로 sync)
    match /consultations/{id} {
      allow read, update, delete: if false;
      allow create: if
        request.resource.data.keys().size() <= 30
        && !request.resource.data.keys().hasAny([
             'status', 'isAdmin', 'role', 'approved', 'verified', 'trusted', 'isVisible',
             'isDeleted', 'isPinned', 'adminResponse', 'adminReply', 'adminMemo', 'authorUid', 'createdBy'
           ])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 20
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 50));
    }

    // 그 외 모든 컬렉션 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
